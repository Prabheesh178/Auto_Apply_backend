PROJECT_NAME="Auto-Apply Backend"
ENVIRONMENT="development"
# Use SQLite locally by default, or provide Supabase / Render Postgres URL:
DATABASE_URL="sqlite+aiosqlite:///./auto_apply.db"
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/auto_apply"

# Gemini API Key (for parsing, matching, tailoring)
GEMINI_API_KEY=""

# Gmail API Credentials
GMAIL_CREDENTIALS_FILE="credentials.json"
GMAIL_TOKEN_FILE="token.json"
